@{
    # ============================================================
    # PCPulse - config.psd1 (EXEMPLE)
    # Copier en "config.psd1" (SANS prefixe GIT_) a la racine du share et adapter.
    # Fichier partage entre le Collector (PS 5.1) et le Dashboard (PS 7). Chaque
    # outil ne lit que les cles de son propre jeu par defaut (merge whitelist),
    # les cles "en trop" pour l'un sont simplement ignorees.
    # ============================================================

    # ---- Collecte (lu par le Collector) ----
    HistoriqueJours      = 30      # profondeur d'analyse des events (jours)
    SeuilBootLong        = 2       # boot > N minutes = "boot long"
    SeuilBootMax         = 30      # borne haute anti-aberrations (minutes)

    # ---- Seuils Dashboard ----
    SeuilDiskAlert       = 10      # % espace libre -> alerte disque
    SeuilCrashRecent     = 7       # fenetre "crash recent" (jours)
    SeuilDiskWarning     = 25      # % espace libre -> warning disque
    SeuilOfflineJours    = 1       # aucune remontee depuis N jours -> offline
    DashboardTitle       = 'PCPulse'
    DashboardSubtitle    = 'Supervision du parc'
    MaskHealthyByDefault = $false  # masquer les PC sains au chargement
    CsvRanges            = 'ip-ranges.csv'   # mapping IP -> site (cf. GIT_ip-ranges.csv)

    # ---- Services critiques surveilles (lu par le Collector, schema 2.2) ----
    # Le Collector releve l'etat de chaque service et le remonte dans le JSON.
    # Le Dashboard repere l'entree Role='EDR' pour le score et le badge securite.
    #   ServiceName          : nom INTERNE du service Windows (Get-Service -Name)
    #   DisplayName          : libelle affiche dans le Dashboard
    #   Id                   : cle logique libre (defaut = ServiceName)
    #   Role                 : 'EDR' pour l'antivirus/EDR structurant ; libre sinon
    #   AlertIfNotInstalled  : $true = un poste sans ce service passe en alerte
    # Liste vide cote code : declarez ici les services de VOTRE parc.
    MonitoredServices = @(
        @{
            Id                  = 'edr'
            ServiceName         = 'YourEDRServiceName'   # nom interne du service de votre EDR
            DisplayName         = 'EDR'
            Role                = 'EDR'
            AlertIfNotInstalled = $true
        }
        # Autres services possibles sans toucher au code, par exemple :
        # @{ Id = 'vpn'; ServiceName = 'YourVpnService'; DisplayName = 'VPN'; Role = 'VPN'; AlertIfNotInstalled = $false }
    )

    # ---- Applis suivies "A investiguer en priorite" (lu par le Dashboard) ----
    # Remontent TOUJOURS en tete du panneau Top Crashers, quelle que soit leur
    # dispersion. Noms de process en minuscules. Mettez-y vos applis metier plus
    # le socle qui compte pour vous.
    PriorityApps = @(
        # -- Socle bureautique / collaboration (exemples) --
        'outlook.exe', 'winword.exe', 'excel.exe',
        'ms-teams.exe', 'onedrive.exe', 'chrome.exe', 'msedge.exe'
        # -- Vos applis metier (exemples a adapter) --
        # , 'votre-appli-metier.exe'
        # , 'votre-agent-securite.exe'
    )

    # ---- Poids du score de risque (lu par le Dashboard) ----
    # Points ajoutes au score d'un PC par type de probleme. Les cles doivent
    # correspondre a celles lues par le Dashboard (liste ci-dessous, exhaustive).
    ScoreWeights = @{
        BSOD         = 5   # ecran bleu
        WHEA         = 4   # erreur materielle fatale
        Crash        = 3   # crash / freeze applicatif
        Thermal      = 3   # surchauffe
        GPU_TDR      = 2   # reset du driver GPU
        DiskAlert    = 2   # disque sature
        BootLong     = 1   # boot long
        Offline      = 3   # machine hors-ligne
        EDRDown      = 5   # service Role='EDR' absent ou arrete
        Battery      = 1   # batterie usee
        BootPerfSlow = 1   # boot lent (perf)
        DiskHealth   = 3   # SMART / usure disque
    }
}
